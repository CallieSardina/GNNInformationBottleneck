#!/bin/bash  -l
#SBATCH --gres=gpu:h200-1g.35gb:1

cd $SLURM_SUBMIT_DIR

/bin/hostname

echo $CUDA_VISIBLE_DEVICES

conda activate fact2

python3 train.py --bmname Mutagenicity --gpu --datadir data --num-classes 2 --name-suffix BASE --notes "Training Mutagenicity with fc layers, no sparsity or discrete loss" --hidden-dim 20 --output-dim 2 --pred-hidden-dim 256 --pred-num-layers 3 --num-gc-layers 3